{
  "compilerOptions": {
    "lib": ["es2018"],
    "target": "es2018",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./build",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "index.ts",   
    "src/configs/mongoMigrate.ts", "src/utils/fetchCountryStateCityDataFromRemoteApi.ts"  ],
  "exclude": [
    "node_modules"
  ]
}
