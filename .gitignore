# ---- Dependencies ----
node_modules/
.npm/
.pnpm-store/
.yarn/

# ---- Build output ----
build/
dist/
*.tsbuildinfo

# ---- Environment and secrets (only .env.example is tracked) ----
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
service-account*.json
credentials*.json

# ---- Runtime data (never in git) ----
# Winston logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# pm2
.pm2/
pids/
*.pid
*.pid.lock
# Phase 12: report PDFs, invoices and branding logos (REPORTS_STORAGE_DIR)
storage/
# User uploads (served from public/, only public/assets is tracked)
public/uploads/
# Temporary files
tmp/
temp/

# ---- Tests and tooling caches ----
coverage/
.nyc_output/
.jest-cache/

# ---- Editors and OS ----
.idea/
.vscode/*
# Shared editor settings: use the project's TypeScript (see docs/OPERATIONS.md, "Editor setup").
!.vscode/settings.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
