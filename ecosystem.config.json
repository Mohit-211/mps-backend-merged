{
  "apps": [
    {
      "name": "mypageseo-software",
      "script": "build/index.js",
      "exec_mode": "cluster",
      "instances": 1,
      "node_args": "--enable-source-maps",
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "1G",
      "exp_backoff_restart_delay": 200,
      "kill_timeout": 10000,
      "time": true,
      "merge_logs": true,
      "env": {
        "NODE_ENV": "production"
      }
    }
  ]
}
