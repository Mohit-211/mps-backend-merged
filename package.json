{
  "name": "mypageseo",
  "version": "1.0.0",
  "description": "My Page Seo a SEO tool that cover all",
  "main": "index.js",
  "scripts": {
    "start": "pm2 start ecosystem.config.json --no-daemon",
    "dev": "cross-env NODE_ENV=development nodemon",
    "build": "tsc -p . && shx cp package.json ./build/package.json && shx cp package-lock.json ./build/package-lock.json && shx cp .env ./build/.env",
    "lint": "eslint src/**/*.ts",
    "lint-fix": "eslint --fix src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "precommit": "npm run lint-fix && npm run format",
    "prepush": "npm run lint",
    "mongo-migrate": "cross-env NODE_ENV=development ts-node --transpile-only ./src/configs/mongoMigrate.ts",
    "seed-country-city-state": "cross-env NODE_ENV=development ts-node ./src/configs/fetchCountryStateCityDataFromRemoteApi.ts"
  },
  "keywords": [
    "Node",
    "Typescript",
    "MongoDb",
    "Boilerplate",
    "Setup"
  ],
  "author": "mypageseo",
  "license": "ISC",
  "dependencies": {
    "@paypal/checkout-server-sdk": "^1.0.3",
    "agenda": "^5.0.0",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "fs-extra": "^11.4.0",
    "google-auth-library": "^9.15.1",
    "googleapis": "^148.0.0",
    "helmet": "^7.2.0",
    "http-proxy-middleware": "^3.0.7",
    "http-status": "^1.8.1",
    "http-status-codes": "^2.3.0",
    "joi": "^17.13.8",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mongoose": "^8.24.4",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "password-validator": "^5.3.0",
    "randomatic": "^3.1.1",
    "razorpay": "^2.9.8",
    "request-ip": "^3.3.0",
    "serpapi": "^2.2.1",
    "sharp": "^0.35.4",
    "slugify": "^1.6.9",
    "square": "^43.2.1",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.35",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/node-cron": "^3.0.11",
    "@types/randomatic": "^3.1.5",
    "@types/request-ip": "^0.0.41",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-jest": "^28.14.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.8",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^7.18.0"
  }
}
